{
  "$schema": "../../schemas/runner_config.schema.json",
  "build_type": "skip-apk",
  "max_iterations": 30,
  "max_model_response_tokens": 8192,
  "reasoning_effort": "high",
  "model": "notarealmodel",
  "allow_unregistered_models": false,
  "agent_mode": "custom",
  "screenshot_mode": false,
  "dry_run": true,
  "gold_run": false,
  "workflow": "exploit",
  "task": null,
  "no_codebase": false,
  "synthetic_vuln_id": "vuln_0",
  "custom_system_prompt": null,
  "agent_image": "cybench/mobilecybench:latest",
  "emulator_display": "headless",
  "emulator_backend": "container",
  "timeout_ms": 600000,
  "allowed_tools": [
    "execute_command",
    "get_current_ui_state",
    "execute_command_with_ui_state"
  ]
}
