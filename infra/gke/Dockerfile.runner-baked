# GKE Runner (baked) — extends the slim orchestrator with emulator + agent
# Docker images pre-baked into /var/lib/docker-baked.
#
# At pod startup, the entrypoint copies the baked Docker data into the emptyDir
# mounted at /var/lib/docker (~1-2 min cp vs ~6-7 min docker load/pull).
#
# This Dockerfile does NOT run dockerd during build. Instead, build_and_push.sh
# prepares the Docker data directory on the host and passes it in as
# .docker-baked/ in the build context.
#
# Build via build_and_push.sh (recommended):
#   bash infra/gke/build_and_push.sh --baked [--push]
#
# Expected image size: ~43-46GB (base ~32GB + emulator ~10GB + agent ~1GB)

ARG BASE_IMAGE=cybench/mobilecybench-orchestrator-slim:latest
FROM ${BASE_IMAGE}

# Install Google Cloud CLI for GCS uploads
RUN apt-get update && apt-get install -y --no-install-recommends \
    apt-transport-https \
    && echo "deb [signed-by=/usr/share/keyrings/cloud.google.gpg] https://packages.cloud.google.com/apt cloud-sdk main" \
       > /etc/apt/sources.list.d/google-cloud-sdk.list \
    && curl -fsSL https://packages.cloud.google.com/apt/doc/apt-key.gpg \
       | gpg --dearmor -o /usr/share/keyrings/cloud.google.gpg \
    && apt-get update \
    && apt-get install -y --no-install-recommends google-cloud-cli \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Copy full codebase (submodules must be initialized on the host before build)
COPY . /mobilecybench
WORKDIR /mobilecybench

# Install Python package in editable mode
RUN /opt/venv/bin/pip install --no-cache-dir -e .

# ─── Bake Docker data from host-prepared directory ────────────────────────
# build_and_push.sh runs a temporary dockerd on the host, pulls emulator +
# agent images, and places the resulting data directory at .docker-baked/
# in the build context. We copy it to /var/lib/docker-baked (not /var/lib/docker
# because the job template mounts emptyDir there for per-pod isolation).
COPY .docker-baked/ /var/lib/docker-baked/

# Copy baked entrypoint
COPY infra/gke/entrypoint-gke-baked.sh /entrypoint-gke.sh
RUN chmod +x /entrypoint-gke.sh

ENTRYPOINT ["/entrypoint-gke.sh"]
