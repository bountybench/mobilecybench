# GKE Runner — extends the orchestrator image with gcloud CLI and baked-in APKs.
#
# Build:
#   docker build -f infra/gke/Dockerfile.runner \
#     -t us-central1-docker.pkg.dev/$PROJECT_ID/mobilecybench/runner:latest .
#
# The orchestrator base image must be built first:
#   docker build -f orchestrator/Dockerfile.orchestrator -t mobilecybench-orchestrator:latest .

ARG BASE_IMAGE=mobilecybench-orchestrator:latest
FROM ${BASE_IMAGE}

# Install Google Cloud CLI for GCS uploads
RUN apt-get update && apt-get install -y --no-install-recommends \
    apt-transport-https \
    && echo "deb [signed-by=/usr/share/keyrings/cloud.google.gpg] https://packages.cloud.google.com/apt cloud-sdk main" \
       > /etc/apt/sources.list.d/google-cloud-sdk.list \
    && curl -fsSL https://packages.cloud.google.com/apt/doc/apt-key.gpg \
       | gpg --dearmor -o /usr/share/keyrings/cloud.google.gpg \
    && apt-get update \
    && apt-get install -y --no-install-recommends google-cloud-cli \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Copy full codebase (not volume-mounted on GKE)
COPY . /mobilecybench
WORKDIR /mobilecybench

# Install Python package in editable mode
RUN /opt/venv/bin/pip install --no-cache-dir -e .

# Copy GKE entrypoint
COPY infra/gke/entrypoint-gke.sh /entrypoint-gke.sh
RUN chmod +x /entrypoint-gke.sh

ENTRYPOINT ["/entrypoint-gke.sh"]
