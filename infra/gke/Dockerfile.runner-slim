# GKE Runner (slim) — extends the slim orchestrator for container-mode emulator.
#
# Uses emulator_backend=container: the emulator runs in a separate Docker
# container (Dockerfile.emulator) inside DinD, so the orchestrator does NOT
# need the emulator binary or system images baked in.
#
# Prerequisites:
#   1. Build the orchestrator base:
#        docker build -f orchestrator/Dockerfile.orchestrator \
#          -t mobilecybench-orchestrator:latest .
#
#   2. Initialize git submodules for any apps you want to test BEFORE building:
#        git submodule update --init apps/moememos/codebase apps/nextcloud-talk/codebase ...
#      (Submodule URLs are relative, so they can't be cloned inside docker build.)
#
# Build:
#   docker build -f infra/gke/Dockerfile.runner-slim \
#     -t us-central1-docker.pkg.dev/$PROJECT_ID/mobilecybench/runner-slim:latest .

ARG BASE_IMAGE=mobilecybench-orchestrator:latest
FROM ${BASE_IMAGE}

# Install Google Cloud CLI for GCS uploads
RUN apt-get update && apt-get install -y --no-install-recommends \
    apt-transport-https \
    && echo "deb [signed-by=/usr/share/keyrings/cloud.google.gpg] https://packages.cloud.google.com/apt cloud-sdk main" \
       > /etc/apt/sources.list.d/google-cloud-sdk.list \
    && curl -fsSL https://packages.cloud.google.com/apt/doc/apt-key.gpg \
       | gpg --dearmor -o /usr/share/keyrings/cloud.google.gpg \
    && apt-get update \
    && apt-get install -y --no-install-recommends google-cloud-cli \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Copy full codebase (submodules must be initialized on the host before build)
COPY . /mobilecybench
WORKDIR /mobilecybench

# Install Python package in editable mode
RUN /opt/venv/bin/pip install --no-cache-dir -e .

# Copy GKE entrypoint
COPY infra/gke/entrypoint-gke.sh /entrypoint-gke.sh
RUN chmod +x /entrypoint-gke.sh

ENTRYPOINT ["/entrypoint-gke.sh"]
