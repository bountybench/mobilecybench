# Optimized Dockerfile for MobileCybench Kali container
# Reduced from ~13GB to ~2GB by using debian-slim base and minimal dependencies
# Target: linux/amd64 (Android SDK build-tools are x86_64 only)
FROM --platform=linux/amd64 debian:bookworm-slim

# Install all dependencies in a single layer to minimize image size
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Core utilities
    bash \
    ca-certificates \
    curl \
    file \
    git \
    gnupg \
    jq \
    libxml2-utils \
    lsof \
    netcat-traditional \
    procps \
    strace \
    tree \
    unzip \
    wget \
    xxd \
    zip \
    # Build essentials for compiling
    build-essential \
    gcc \
    # Python 3.11 (available in bookworm, compatible with agent)
    python3 \
    python3-pip \
    python3-venv \
    # Android tools
    android-tools-adb \
    android-tools-fastboot \
    # Java for Android SDK
    openjdk-17-jdk-headless \
    # Docker support
    docker.io \
    iptables \
    # Search tools
    ripgrep \
    # Network tools for security testing
    tshark \
    && rm -rf /var/lib/apt/lists/*

# Setup Python virtual environment
WORKDIR /app
RUN python3 -m venv /venv

ENV PATH="/venv/bin:$PATH"

# Install Python packages
RUN /venv/bin/pip install --no-cache-dir --upgrade pip && \
    /venv/bin/pip install --no-cache-dir semgrep && \
    ln -s /venv/bin/semgrep /usr/local/bin/semgrep

# Configure git for bind mount compatibility
RUN git config --global --add safe.directory '*'

# Install docker-compose
RUN curl -sL "https://github.com/docker/compose/releases/latest/download/docker-compose-$(uname -s)-$(uname -m)" \
    -o /usr/local/bin/docker-compose && chmod +x /usr/local/bin/docker-compose

# Android SDK for building exploit APKs (aapt, d8, zipalign, apksigner)
ENV ANDROID_HOME=/opt/android-sdk
ENV PATH="${ANDROID_HOME}/build-tools/34.0.0:${ANDROID_HOME}/cmdline-tools/latest/bin:${PATH}"

RUN mkdir -p ${ANDROID_HOME} && \
    curl -sL -o /tmp/cmdtools.zip https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip && \
    unzip -q /tmp/cmdtools.zip -d ${ANDROID_HOME}/cmdline-tools && \
    mv ${ANDROID_HOME}/cmdline-tools/cmdline-tools ${ANDROID_HOME}/cmdline-tools/latest && \
    yes | ${ANDROID_HOME}/cmdline-tools/latest/bin/sdkmanager --licenses > /dev/null 2>&1 && \
    ${ANDROID_HOME}/cmdline-tools/latest/bin/sdkmanager --install "platforms;android-34" "build-tools;34.0.0" && \
    rm -rf /tmp/cmdtools.zip ${ANDROID_HOME}/cmdline-tools/latest/lib/testing-* ${ANDROID_HOME}/.android
