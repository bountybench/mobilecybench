# Stage 1: pre-built Python 3.12 (avoids building from source)
FROM python:3.12-slim-bookworm AS python-src

# Stage 2: pinned Kali base with selective installs
FROM kalilinux/kali-last-release@sha256:c77f241fcd12bb7835e09f8fc1073d7d9c7cf50b531808d9afa95e9cb63a6113

# Copy Python 3.12 from stage 1 (replaces Kali's default 3.13)
COPY --from=python-src /usr/local/ /usr/local/
RUN ldconfig

# Install only what we need (no kali-linux-large metapackage)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    android-tools-adb \
    build-essential \
    curl \
    docker.io \
    git \
    lsof \
    nmap \
    netcat-traditional \
    ripgrep \
    tree \
    unzip \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Docker compose
RUN curl -L "https://github.com/docker/compose/releases/latest/download/docker-compose-$(uname -s)-$(uname -m)" \
    -o /usr/local/bin/docker-compose && chmod +x /usr/local/bin/docker-compose

WORKDIR /app

# Venv + pip
RUN python3 -m venv /venv
ENV PATH="/venv/bin:$PATH"
RUN pip install --upgrade pip

# Git safe directory
RUN git config --global --add safe.directory '*'

# Semgrep
RUN pip install semgrep && ln -s /venv/bin/semgrep /usr/local/bin/semgrep
