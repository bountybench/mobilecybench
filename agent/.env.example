# Copy to agent/.env and fill in the providers you plan to use.
OPENAI_API_KEY=sk-your-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here
GEMINI_API_KEY=your-key-here
CODEX_API_KEY=your-key-here

# Custom provider integrations registered via register_provider() in
# agent/model_providers/litellm_provider.py declare their own *_API_KEY env
# variable. Add it here when you wire up a new model.
# Example: MYPROVIDER_API_KEY=...

# Claude Code (OAuth - requires Claude Pro/Max/Team/Enterprise subscription)
#
# Recommended: generate a long-lived token (valid ~1 year, decoupled
# from your interactive `claude` session, no rotation contention):
#
#   npm install -g @anthropic-ai/claude-code
#   claude setup-token                  # prints a token; copy it below
#
# *** IMPORTANT: when migrating from the legacy rotating-pair flow to
#     setup-token, blank-out or DELETE the CLAUDE_CODE_OAUTH_REFRESH_TOKEN
#     line below. If you paste a new setup-token into the line above but
#     leave a populated old refresh token below, the runner stays on the
#     legacy path and reuses your dead refresh token, 401-ing on first
#     inference. End state should be a single non-empty Claude Code
#     line: CLAUDE_CODE_OAUTH_TOKEN=<setup-token>.
#
# The runner forwards CLAUDE_CODE_OAUTH_TOKEN into the agent container
# directly (CLI auth precedence #5;
# see https://code.claude.com/docs/en/authentication).
CLAUDE_CODE_OAUTH_TOKEN=

# Legacy / fallback only: rotating subscription pair extracted from the
# OS secret store. Setting BOTH this AND CLAUDE_CODE_OAUTH_TOKEN above
# switches the runner to the old flow that writes
# ~/.claude/.credentials.json inside the container.
#
# AVOID if possible — refresh rotates these tokens globally for your
# account and invalidates any concurrent Claude Code client (including
# an interactive `claude` window on this host), so a sweep can die
# mid-iteration whenever you use Claude Code interactively.
#
# If you previously used this path and have now run `claude setup-token`,
# DELETE the line below entirely (do not just blank the value) so the
# runner takes the setup-token path. A loud banner is logged at runner
# startup if the legacy path is taken; watch for it.
#
# macOS (reads from Keychain):
#   CREDS=$(security find-generic-password -s "Claude Code-credentials" -w)
#   echo "$CREDS" | python3 -c "import json,sys; c=json.load(sys.stdin)['claudeAiOauth']; \
#     print(f'CLAUDE_CODE_OAUTH_TOKEN={c[\"accessToken\"]}\nCLAUDE_CODE_OAUTH_REFRESH_TOKEN={c[\"refreshToken\"]}')"
#
# Linux: ~/.claude/.credentials.json or your distro's secret manager.
CLAUDE_CODE_OAUTH_REFRESH_TOKEN=
