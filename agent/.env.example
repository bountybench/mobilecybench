# Copy to agent/.env and fill in the providers you plan to use.
OPENAI_API_KEY=sk-your-key-here
GEMINI_API_KEY=your-key-here
CODEX_API_KEY=your-key-here

# Claude Code (OAuth - requires Claude Max/Pro subscription)
# 1. Install and log in:  npm install -g @anthropic-ai/claude-code && claude auth login
# 2. Extract tokens into this file. Tokens expire — re-run before each session.
#
# macOS (reads from Keychain):
#   CREDS=$(security find-generic-password -s "Claude Code-credentials" -w)
#   echo "$CREDS" | python3 -c "import json,sys; c=json.load(sys.stdin)['claudeAiOauth']; \
#     print(f'CLAUDE_CODE_OAUTH_TOKEN={c[\"accessToken\"]}\nCLAUDE_CODE_OAUTH_REFRESH_TOKEN={c[\"refreshToken\"]}')"
#
# Linux: credentials are stored in a platform-specific secret store.
#   Check ~/.claude/.credentials.json or your distro's secret manager.
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_CODE_OAUTH_REFRESH_TOKEN=
