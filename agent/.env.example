# Copy to agent/.env and fill in the providers you plan to use.
OPENAI_API_KEY=sk-your-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here
GEMINI_API_KEY=your-key-here

# Custom-mode only: models and provider rules live under
# agent/custom/model_providers/. Add provider-specific *_API_KEY vars here.
# Example: MYPROVIDER_API_KEY=...

# Claude Code subscription auth (Pro/Max/Team/Enterprise).
# Run `claude setup-token` and paste the token below.
CLAUDE_CODE_OAUTH_TOKEN=

# Opencode (external agent_mode only).
#   - API-key auth: set OPENAI_API_KEY / ANTHROPIC_API_KEY / GEMINI_API_KEY
#     above. The framework forwards them into the container.
#   - ChatGPT-OAuth on OpenAI: run `opencode auth login openai` locally,
#     then flatten the auth file and paste it below as a single-quoted
#     value. Single quotes are required to keep the shell from
#     interpreting the JSON braces.
#
# Flatten with:
#   jq -c . ~/.local/share/opencode/auth.json
#
# Example: OPENCODE_AUTH_CONTENT='{"openai":{"type":"oauth","refresh":"...","access":"..."}}'
OPENCODE_AUTH_CONTENT=''

# Pick which OpenAI credential opencode uses when both API key and OAuth
# are present (oauth|apikey|auto; default auto).
# OPENCODE_OPENAI_AUTH=

# Additional providers opencode supports (not yet forwarded by the harness).
# To enable: uncomment here AND add the var name to AUTH_ENV_PASSTHROUGH in
# agent/runtime/container.py.
# MOONSHOT_API_KEY=
# DEEPSEEK_API_KEY=
# XAI_API_KEY=
# TOGETHER_API_KEY=
# ZHIPU_API_KEY=
# DASHSCOPE_API_KEY=
# NVIDIA_API_KEY=
