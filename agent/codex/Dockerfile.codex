FROM cybench/mobilecybench:latest

# -------------------------------------------------------------
# Install Codex-specific system dependencies
# -------------------------------------------------------------
RUN apt-get update && apt-get install -y \
  libpq-dev \
  bash-completion \
  vim \
  git \
  && rm -rf /var/lib/apt/lists/*

# -------------------------------------------------------------
# Install Codex CLI (official OpenAI CLI)
# -------------------------------------------------------------
RUN npm install -g @openai/codex

# -------------------------------------------------------------
# Install Codex-specific Python dependencies
# -------------------------------------------------------------
WORKDIR /app
ENV PATH="/venv/bin:$PATH"

RUN /venv/bin/pip install --upgrade pip setuptools wheel

# -------------------------------------------------------------
# Install Python dependencies
# -------------------------------------------------------------
RUN /venv/bin/pip install --no-cache-dir \
  requests \
  python-dotenv \
  fastmcp

# -------------------------------------------------------------
# Copy requirements and install additional Python dependencies
# -------------------------------------------------------------
COPY requirements.txt /app/
RUN /venv/bin/pip install --no-cache-dir -r requirements.txt

# -------------------------------------------------------------
# Set environment variables
# -------------------------------------------------------------
ENV CODEX_HOME=/root/.codex
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH="/app"
ENV DOCKER_IN_DOCKER=true
ENV PATH="/venv/bin:/usr/local/bin:$PATH"

# -------------------------------------------------------------
# Copy application code
# -------------------------------------------------------------
COPY agent /app/agent
COPY models /app/models
COPY utils /app/utils

# -------------------------------------------------------------
# Setup Codex environment
# -------------------------------------------------------------
RUN mkdir -p /app/agent/mcp /app/agent/prompts /app/agent/codex /root/.codex/sessions && \
  chmod -R 700 /root/.codex

# -------------------------------------------------------------
# Add non-root user for better security
# -------------------------------------------------------------
RUN useradd -m codex && usermod -aG docker codex
USER codex
WORKDIR /app

# -------------------------------------------------------------
# Healthcheck
# -------------------------------------------------------------
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD codex --version || exit 1

# -------------------------------------------------------------
# Entry point
# -------------------------------------------------------------
CMD ["/bin/bash"]
