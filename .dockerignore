# Applies to repo-root builds (codex / claudecode BYO images).
# Must exist BEFORE the first COPY — added later, the secret stays in layer history.

# Secrets — agent/.env holds operator API tokens, read at runtime via load_dotenv.
**/.env
**/.env.*

# Build bloat
# Previously excluded ALL of .git/ but runner.py inside the image calls
# `git submodule update --init` (via ensure_app_submodule). Without
# .git/config + .git/modules, that fails with "not a git repository".
# Include the minimal git metadata needed; exclude pure bloat.
.git/objects/pack/
.git/lfs/
.git/logs/
.git/hooks/
.pytest_cache/
.ruff_cache/
**/*.egg-info/
**/__pycache__/
**/*.pyc
**/*.pyo
