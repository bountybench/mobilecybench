{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobilecybench.dev/schemas/app_catalog.schema.json",
  "title": "App Catalog",
  "description": "Machine-readable benchmark app sets used by batch runner defaults.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "sets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "in_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "unreliable": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "in_scope"
      ]
    },
    "notes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "description"
        ]
      }
    }
  },
  "required": [
    "sets"
  ]
}
