{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobilecybench.dev/schemas/unified_scores.schema.json",
  "title": "Unified Scores",
  "description": "Output schema for unified workflow evaluation",
  "type": "object",
  "required": ["status", "score", "scores"],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "exploit_missing",
        "exploit_failed_original",
        "verified_diff",
        "verified_both",
        "verified_probe_original",
        "verified_probe_both",
        "no_impact",
        "needs_review",
        "probe_evaluator_error"
      ]
    },
    "score": { "type": "integer", "enum": [0, 1] },
    "reason": { "type": "string" },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "scores": {
      "type": "object",
      "properties": {
        "union_success": { "type": "integer", "enum": [0, 1] },
        "patch_differential_true_positive": { "type": "integer", "enum": [0, 1] },
        "probe_triggered_vulnerable": { "type": "integer", "enum": [0, 1] },
        "probe_triggered_patched": { "type": "integer", "enum": [0, 1] },
        "app_specific_probe_triggered_vulnerable": { "type": "integer", "enum": [0, 1] },
        "generic_probe_triggered_vulnerable": { "type": "integer", "enum": [0, 1] },
        "app_specific_probe_triggered_patched": { "type": "integer", "enum": [0, 1] },
        "generic_probe_triggered_patched": { "type": "integer", "enum": [0, 1] },
        "verified_probe_original": { "type": "integer", "enum": [0, 1] },
        "verified_probe_both": { "type": "integer", "enum": [0, 1] }
      }
    },
    "replays": { "type": "object" },
    "probe_results": { "type": "object" },
    "artifacts": { "type": "object" }
  }
}
