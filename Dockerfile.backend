# syntax=docker/dockerfile:1.4
# Use budtmo/docker-android as base - it includes Android SDK, emulator, Java, VNC
FROM budtmo/docker-android:emulator_14.0

USER root
ENV DEBIAN_FRONTEND=noninteractive
ENV PYENV_ROOT=/root/.pyenv
ENV GRADLE_USER_HOME=/root/.gradle
ENV PATH="$PYENV_ROOT/bin:$PYENV_ROOT/shims:$PATH"
WORKDIR /mobilecybench

# Install essential build tools
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      software-properties-common \
      ca-certificates \
      curl \
      gnupg \
      wget \
      git \
      build-essential \
      libffi-dev \
      libssl-dev \
      libpq-dev \
      netcat-openbsd \
      procps \
      sudo \
      pass \
    && rm -rf /var/lib/apt/lists/*

# Install Python 3.11 from deadsnakes PPA
RUN add-apt-repository ppa:deadsnakes/ppa -y && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
      python3.11 \
      python3.11-dev \
      python3.11-venv \
      python3-pip \
    && rm -rf /var/lib/apt/lists/* && \
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1 && \
    update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1

# Install Docker for DinD
RUN mkdir -p /etc/apt/keyrings && \
    curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu $(lsb_release -cs) stable" > /etc/apt/sources.list.d/docker.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
      docker-ce \
      docker-ce-cli \
      containerd.io \
      docker-buildx-plugin \
      docker-compose-plugin \
    && rm -rf /var/lib/apt/lists/* && \
    mkdir -p /var/lib/docker

# Install Node.js 20
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    rm -rf /var/lib/apt/lists/*

# Configure git
RUN git config --global user.email "temp@example.com" && \
    git config --global user.name "Temp"

# Install Python dependencies
COPY requirements.txt /mobilecybench/requirements.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    python3 -m pip install --break-system-packages --ignore-installed --upgrade pip setuptools wheel && \
    pip install --break-system-packages -r /mobilecybench/requirements.txt

# Copy scripts
COPY tools/dockerd_entrypoint.sh /usr/local/bin/dockerd_entrypoint.sh
COPY tools/entrypoint.sh /usr/local/bin/entrypoint.sh
COPY tools/setup_submodules.sh /usr/local/bin/setup_submodules.sh
RUN chmod +x /usr/local/bin/dockerd_entrypoint.sh /usr/local/bin/entrypoint.sh /usr/local/bin/setup_submodules.sh

# Create directories
RUN mkdir -p /mobilecybench/results /mobilecybench/logs /root/.gradle

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s \
  CMD docker info >/dev/null 2>&1 || exit 1

EXPOSE 7999 5037 5554 5555 5900

ENTRYPOINT ["dockerd_entrypoint.sh"]
CMD ["/usr/local/bin/entrypoint.sh"]
