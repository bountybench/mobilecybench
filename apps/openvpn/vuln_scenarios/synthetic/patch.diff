+        if (intent == null || !IMPORT_ACTION.equals(intent.getAction())) {
+            return;
+        }
+        
+        String source = intent.getStringExtra(IMPORT_SOURCE_EXTRA);
+        String importData = intent.getStringExtra(IMPORT_DATA_EXTRA);
+        
+        if (source == null || importData == null) {
+            VpnStatus.logError("Invalid import broadcast - missing data");
+            return;
+        }
+        
+        VpnStatus.logInfo("Processing profile import from source: " + source);
+        
+        try {
+            // Parse the import data and create profile
+            VpnProfile profile = new VpnProfile("imported-" + System.currentTimeMillis());
+            profile.mConnections[0] = parseConnectionData(importData);
+            
+            // Auto-add the profile
+            addProfile(context, profile);
+            VpnStatus.logInfo("Profile imported successfully: " + profile.mName);
+        } catch (Exception e) {
+            VpnStatus.logError("Failed to import profile: " + e.getMessage());
+        }
+    }
