+package de.blinkt.openvpn.core;
+
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+
+public class ProfileImportReceiver extends BroadcastReceiver {
+    private static final String IMPORT_ACTION = "de.blinkt.openvpn.IMPORT_PROFILE";
+    private static final String IMPORT_SOURCE_EXTRA = "de.blinkt.openvpn.IMPORT_SOURCE";
+    private static final String IMPORT_DATA_EXTRA = "de.blinkt.openvpn.IMPORT_DATA";
+
+    @Override
+    public void onReceive(Context context, Intent intent) {
+        android.util.Log.e("EXPLOIT_TEST", "!!! BROADCAST RECEIVED !!!");
+        
+        if (intent == null || !IMPORT_ACTION.equals(intent.getAction())) {
+            android.util.Log.e("EXPLOIT_TEST", "Wrong action or null intent");
+            return;
+        }
+
+        String source = intent.getStringExtra(IMPORT_SOURCE_EXTRA);
+        String importData = intent.getStringExtra(IMPORT_DATA_EXTRA);
+
+        android.util.Log.e("EXPLOIT_TEST", "Source: " + source);
+        android.util.Log.e("EXPLOIT_TEST", "Data: " + importData);
+
+        if (source == null || importData == null) {
+            android.util.Log.e("EXPLOIT_TEST", "Missing data");
+            return;
+        }
+
+        try {
+            ProfileManager pm = ProfileManager.getInstance(context);
+            pm.handleImportBroadcast(context, intent);
+            android.util.Log.e("EXPLOIT_TEST", "!!! PROFILE IMPORTED !!!");
+        } catch (Exception e) {
+            android.util.Log.e("EXPLOIT_TEST", "Error: " + e.getMessage());
+            e.printStackTrace();
+        }
+    }
+}
