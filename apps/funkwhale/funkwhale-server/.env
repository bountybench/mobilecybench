# Funkwhale Configuration for MobileCybench Testing
# This is a template file - setup.sh will create .env from this

# Funkwhale version
FUNKWHALE_VERSION=1.4.0

# Server configuration
FUNKWHALE_HOSTNAME=10.0.2.2
FUNKWHALE_PROTOCOL=http
DJANGO_SECRET_KEY=insecure-test-key-for-mobilecybench
DJANGO_ALLOWED_HOSTS=localhost,10.0.2.2

# Network configuration
FUNKWHALE_API_IP=0.0.0.0
FUNKWHALE_API_PORT=5000

# Media and static files
MEDIA_URL=http://10.0.2.2/media/
STATIC_URL=http://10.0.2.2/staticfiles/

# SPA Configuration - API fetches SPA from front service
FUNKWHALE_SPA_HTML_ROOT=http://front

# Database configuration
DATABASE_URL=postgresql://funkwhale:password@postgres:5432/funkwhale
POSTGRES_DB=funkwhale
POSTGRES_USER=funkwhale
POSTGRES_PASSWORD=password

# Cache and Celery
CACHE_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

# Paths (will be replaced with actual paths during setup)
FUNKWHALE_DATA_PATH=/Users/johnnyli/SAIL/mobilecybench/apps/funkwhale/funkwhale-server
MUSIC_DIRECTORY_PATH=/music
MUSIC_DIRECTORY_SERVE_PATH=/Users/johnnyli/SAIL/mobilecybench/apps/funkwhale/funkwhale-server/data/music
MEDIA_ROOT=/Users/johnnyli/SAIL/mobilecybench/apps/funkwhale/funkwhale-server/data/media
STATIC_ROOT=/Users/johnnyli/SAIL/mobilecybench/apps/funkwhale/funkwhale-server/data/static

# Nginx
NGINX_MAX_BODY_SIZE=100M
PROXY_MEDIA=false
