version: 1

formatters:
    simple:
        format: '%(asctime)s - %(name)s - %(levelname)s - %(message)s'

handlers:
    file:
        class: logging.handlers.TimedRotatingFileHandler
        formatter: simple
        filename: /data/homeserver.log
        when: midnight
        backupCount: 1
        encoding: utf8

root:
    level: INFO
    handlers: [file]

disable_existing_loggers: false