# SimpleLogin Configuration for Local Testing
# Reference: https://github.com/simple-login/app/blob/master/example.env
URL=https://simplelogin_tls_proxy
DB_URI=postgresql://simplelogin:password@db:5432/simplelogin
FLASK_SECRET=dev-only-secret-for-testing

DISABLE_EMAIL_VERIFICATION=1
DISABLE_ONBOARDING=1
EMAIL_DOMAIN=simplelogin.local
SUPPORT_EMAIL=support@simplelogin.local
ADMIN_EMAIL=admin@simplelogin.local
EMAIL_SERVERS_WITH_PRIORITY=[]
