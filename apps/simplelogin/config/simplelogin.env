# Core SimpleLogin Configuration for Local Testing
URL=http://localhost:7777
DB_URI=postgresql://simplelogin:password@db:5432/simplelogin
FLASK_SECRET=dev-only-secret-for-testing

# Auth & UX for local testing
DISABLE_EMAIL_VERIFICATION=1
DISABLE_ONBOARDING=1
# DISABLE_REGISTRATION removed to enable registration
EMAIL_DOMAIN=simplelogin.local
SUPPORT_EMAIL=support@simplelogin.local
ADMIN_EMAIL=admin@simplelogin.local

# Turn off external mail dependencies
EMAIL_SERVERS_WITH_PRIORITY=[]

# Development settings
FLASK_ENV=development
DEBUG=1

# Server binding configuration
FLASK_HOST=0.0.0.0
FLASK_PORT=7777
