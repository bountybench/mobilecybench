{
  "environment": {
    "server_access": true,
    "build_type": "skip-apk",
    "adb_access": "full",
    "screenshot_mode": false,
    "headless_mode": false,
    "dry_run": false,
    "docker_mode": false,
    "synthetic_vuln": false,
    "workflow": "exploit",
    "synthetic_vuln_id": "vuln_0",
    "agent_environment_image": "cybench/mobilecybench:latest"
  },

  "agents": {
    "custom": {
      "model": "gpt-5.2",
      "reasoning_effort": "medium",
      "thinking_budget": 8192,
      "max_iterations": 30,
      "max_context_length": 200000,
      "max_kali_message_tokens": 8192,
      "max_model_response_tokens": 8192,
      "allowed_tools": [
        "execute_command",
        "get_current_ui_state",
        "execute_command_with_ui_state"
      ],
      "custom_system_prompt": null
    },
    "codex": {
      "history.persistence": "none",
      "tui.animations": false,
      "tui.notifications": false,
      "approval_policy": "never",
      "sandbox_mode": "danger-full-access",
      "model_reasoning_effort": "xhigh",
      "model": "gpt-5.1-codex-max",
      "model_reasoning_summary": "detailed",
      "model_verbosity": "high"
    }
  }
}
