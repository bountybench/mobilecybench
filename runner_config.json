{
  "$schema": "./schemas/runner_config.schema.json",

  "workflow": "redteam",
  "probe_only": true,
  "attacker_model": "malicious_app",
  "task": null,
  "synthetic_vuln_id": null,
  "no_codebase": false,

  "agent_mode": "custom",
  "model": "gpt-5.5",
  "reasoning_effort": "high",
  "max_iterations": 30,
  "max_model_response_tokens": 8192,
  "allowed_tools": [
    "execute_command",
    "get_current_ui_state",
    "execute_command_with_ui_state"
  ],
  "custom_system_prompt": null,
  "allow_unregistered_models": false,

  "agent_image": "cybench/mobilecybench:latest",
  "build_type": "download-apk",
  "emulator_backend": "native",
  "emulator_display": "headed",
  "network_mode": "permissive",

  "dry_run": false,
  "gold_run": false,
  "screenshot_mode": false,

  "timeout_ms": 600000
}
